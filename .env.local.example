# Copy this file to .env.local and fill in your Supabase project values.
# Find them in Supabase Dashboard -> Project Settings -> API.
#
# If you leave these blank, the app runs in DEMO mode using the browser's
# localStorage (no backend needed) so you can try it before wiring Supabase.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: a simple shared passphrase to gate access to the app.
# Leave blank to disable the gate. (This is a light lock, not real auth.)
NEXT_PUBLIC_APP_PASSCODE=
